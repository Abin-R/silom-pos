{
  "expo": {
    "name": "Brave POS",
    "slug": "brave-pos",
    "version": "1.5.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bravepos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.bravebrand.pos",
      "infoPlist": {
        "UISupportedExternalAccessoryProtocols": ["jp.star-m.starpro"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "Brave POS uses Bluetooth to find and connect to receipt printers.",
        "NSLocalNetworkUsageDescription": "Brave POS uses your local network to find and print to receipt printers.",
        "AppStoreID": "6835755529",
        "AppStoreCountry": "th"
      }
    },
    "android": {
      "package": "com.bravebrand.pos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FB9FE7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "the-rolling-pinn"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "./plugins/withBravePosPrinter",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "@logrocket/react-native",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a3cd2b5-54ec-49b1-9476-af6497db4529"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "therollingpinn",
    "updates": {
      "url": "https://u.expo.dev/2a3cd2b5-54ec-49b1-9476-af6497db4529"
    }
  }
}
