{
  "expo": {
    "name": "Brave POS",
    "slug": "brave-pos",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bravepos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.bravebrand.pos"
    },
    "android": {
      "package": "com.bravebrand.pos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "./plugins/withThermalPrinterFix",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "651113c4-3bab-4220-a652-6ce53921fe29"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "shopsterabin123",
    "updates": {
      "url": "https://u.expo.dev/651113c4-3bab-4220-a652-6ce53921fe29"
    }
  }
}
